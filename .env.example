# Test keys only. Never a live key.
PAYSTACK_SECRET_KEY=sk_test_xxx
# Bearer token Chord sends to the tool; any long random string.
MCP_TOKEN=
# Signs quotes, offers and pickup codes; any long random string.
QUOTE_SECRET=
# Optional. ISO date; payments before it do not count as sales (resets the demo stock).
STOCK_EPOCH=
# Optional. The owner's Google Sheet tabs, each published to the web as CSV. Without them the tool uses tool/data.
PRICES_SHEET_PRICES_URL=
PRICES_SHEET_FAULTS_URL=
PRICES_SHEET_STOCK_URL=
# Evals only.
CHORD_API_KEY=
CHORD_WORKSPACE_ID=
CHORD_TEAMMATE_ID=
